# Server Port
PORT=5000

# Embedding Provider: local (default, zero-config), voyage, or openai
EMBEDDING_PROVIDER=local

# Voyage AI Key (optional, if EMBEDDING_PROVIDER=voyage)
# VOYAGE_API_KEY=your_voyage_key
# VOYAGE_MODEL=voyage-3-lite

# OpenAI Key (optional, if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude Key (optional, for LLM-based message tagging during ingest)
# ANTHROPIC_API_KEY=your_claude_key
